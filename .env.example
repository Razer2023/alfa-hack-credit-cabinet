# Скопируйте в .env и при необходимости поменяйте. Здесь только dev-значения.

POSTGRES_PASSWORD=credit-dev-only

# Ключ подписи JWT: не короче 32 символов
CORE_JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
# Пароль всех демо-пользователей (coffee, stroy, vector, manager, underwriter)
CORE_DEMO_PASSWORD=demo

# http — настоящие сервисы B и C (по умолчанию); stub — встроенные заглушки ядра
CORE_INTEGRATIONS_MODE=http
CORE_SCORING_MODE=http

# Пауза между автоматическими шагами, чтобы на демо было видно движение статусов (секунды)
CORE_PIPELINE_STEP_DELAY_SECONDS=2
# Показывать код подтверждения в интерфейсе вместо SMS
CORE_DEMO_CODES=true
